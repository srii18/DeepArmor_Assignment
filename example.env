# AWS Credentials and Configuration
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=your_region_here

# Optional: AWS Session Token (if using temporary credentials)
# AWS_SESSION_TOKEN=your_session_token_here

# Optional: Specific AWS Profile to use (if not using default)
# AWS_PROFILE=your_profile_name

# Optional: Custom settings for the scanner
# SCAN_REGIONS=us-east-1,us-west-2  # Comma-separated list of regions to scan
# MAX_RESULTS=100  # Maximum number of resources to scan per service
